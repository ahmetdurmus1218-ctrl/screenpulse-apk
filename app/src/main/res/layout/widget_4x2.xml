<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="18dp"
    android:gravity="center_vertical">

    <!-- Left: header + ring -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/widget_sun_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentLeft="true" />

            <ImageView
                android:id="@+id/widget_battery_icon"
                android:layout_width="26dp"
                android:layout_height="13dp"
                android:layout_alignParentRight="true" />
        </RelativeLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="4dp" />

        <ImageView
            android:id="@+id/widget_sot_ring"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- Right: divider + stacked stats -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:background="#14FFFFFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/widget_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%55"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_cycle_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="12 dng"
                android:textColor="#99AAB8E8"
                android:textSize="12sp"
                android:layout_marginBottom="3dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pil Seviyesi"
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/widget_sot_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6sa 42dk"
            android:textColor="#7A97FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Şarjdan Beri"
            android:textColor="#66FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
